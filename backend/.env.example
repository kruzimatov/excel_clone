## Backend local development environment variables
## Copy to `backend/.env`.

PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/excel_clone
CORS_ORIGIN=http://localhost:5173

# Basic Auth (optional, recommended)
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Save integrations (optional)
APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

